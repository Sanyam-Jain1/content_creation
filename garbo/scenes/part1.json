        { "who": "araceli", "text": "'My man in Glasgow will do anything for a litre of wine'? The British don't even use litres!", "lang": "en", "gap": 0.4 },
        { "who": "juan", "text": "Do the Germans know that?", "lang": "en", "gap": 0.4, "state": { "smile": 0.8 } }
      ]
    },
