      "lines": [
        { "who": "juan", "text": "I travel to London on business. Let me serve the Reich.", "lang": "en" },
        { "who": "frederico", "text": "Recruit agents. Send us everything.", "lang": "en", "gap": 0.5 }
      ]
    },
